<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!--
        Proyecto:
        SIGTAL - API para registro y autenticación

        Evidencia:
        GA7-220501096-AA5-EV01

        Tecnología:
        Spring Boot + Java + Maven + MySQL
    -->

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <!-- Información general del proyecto -->
    <groupId>com.sigtal</groupId>
    <artifactId>sigtal-api-aa5-ev01</artifactId>
    <version>1.0-SNAPSHOT</version>

    <name>SIGTAL API - AA5 EV01</name>

    <description>
        Servicio web REST para registro e inicio de sesión
        desarrollado para la evidencia GA7-220501096-AA5-EV01
    </description>

    <!-- Versión de Java utilizada -->
    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>

        <!--
            Spring Web permite crear servicios web REST
            y manejar peticiones HTTP.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            Spring Data JPA permite trabajar con
            la base de datos mediante entidades.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Driver para conectar Spring Boot con MySQL -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Herramientas de desarrollo -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- Dependencias para pruebas -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <!-- Plugin que permite ejecutar Spring Boot -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

        </plugins>
    </build>

</project>